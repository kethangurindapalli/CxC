# MongoDB Atlas Connection String (Free Tier)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/projectconnect?retryWrites=true&w=majority

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Expiration
JWT_EXPIRES_IN=7d

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development
